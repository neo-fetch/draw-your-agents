{
  "name": "graphical-agents",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Visual builder that compiles a drag-and-drop agent graph into runnable Google ADK graph-workflow projects.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "check:ir": "node scripts/check-ir.ts packages/ir/fixtures/*.ir.json",
    "build": "tsc -b",
    "test:ir": "node --test \"packages/ir/test/**/*.test.ts\"",
    "test:codegen": "node --test \"packages/codegen/test/**/*.test.ts\"",
    "test:web": "node --test \"apps/web/test/**/*.test.ts\"",
    "test:web:app": "node --test \"apps/web/test-app/**/*.test.ts\"",
    "test": "npm run check:ir && npm run test:ir && npm run test:codegen && npm run test:web",
    "test:e2e": "node scripts/e2e.ts",
    "test:e2e:live": "node scripts/e2e.ts --live",
    "build:pages": "npm run build --workspace=apps/web"
  }
}
